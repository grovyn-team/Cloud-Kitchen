# Grovyn — docker-compose environment template. Copy to `.env` (gitignored)
# and set real values before running `docker compose up`. NEVER commit `.env`.

# Postgres superuser password -- used only by the `postgres`/`migrate`
# services to create the database and bootstrap the two application roles.
# Not read by the running backend at all.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# The two application-role passwords `drizzle/bootstrap-roles.sql` creates
# (or, on a re-run, ALTERs to these values -- see `backend/scripts/migrate.sh`).
# `grovyn_migrator` is BYPASSRLS (schema/migration-time only, never serves a
# request); `grovyn_app` is the NOBYPASSRLS runtime role every request runs
# as. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
GROVYN_MIGRATOR_PASSWORD=change-me-migrator
GROVYN_APP_PASSWORD=change-me-app

# Comma-separated allowed CORS origins for the backend. Set to your real
# public frontend URL in production (the compose default below only works
# for a same-host deployment reached via the frontend's own published port).
CORS_ORIGIN=http://localhost:8080

# Host port the frontend (nginx) is published on.
FRONTEND_PORT=8080
