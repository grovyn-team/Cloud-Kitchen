# Grovyn backend — environment template. Copy to `.env` (which is gitignored).
# NEVER put real secrets in this file; it is committed as a template only.

# Runtime
NODE_ENV=development
PORT=3001

# CORS: comma-separated allowed origins. In production this MUST be an explicit
# allowlist (never "*" with credentials). Dev defaults to "*" if unset.
# CORS_ORIGIN=https://app.example.com,http://localhost:5173

# Session token signing secret (HMAC). REQUIRED in production.
# The app currently falls back to a public default if this is unset — that is a
# known CRITICAL issue (SECURITY_REVIEWS/000-baseline-owasp.md, SEC-01) that
# Phase 1 will change to fail-boot-if-missing. Set a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value

# DEMO ONLY. Shared demo login password used by the current template and the
# `npm run verify` smoke test. This must NEVER be a real tenant credential and
# must be unreachable in production once real auth (D-005) lands.
AUTH_DEMO_PASSWORD=grovyn@123

# --- Database (P1-01) -------------------------------------------------------
# Runtime app connection. In production this MUST point at a role with
# NOBYPASSRLS (e.g. `grovyn_app` — see drizzle/0001_force_rls_and_grants.sql)
# so Postgres Row-Level Security (D-001 amendment) is actually enforced as the
# backstop behind the application-layer DAL. Nothing in the current runtime
# code reads this yet — request-time wiring is P1-02 (context middleware) /
# P1-03 (DAL), not this task.
# DATABASE_URL=postgresql://grovyn_app:changeme@localhost:5432/grovyn

# Migrator connection used ONLY by `npm run db:generate` / `db:migrate`
# (drizzle-kit CLI, see drizzle.config.js). MUST be a BYPASSRLS role (e.g.
# `grovyn_migrator`) so schema DDL and any future seed script can write
# across all tenants. NEVER use this role/URL for request-serving code.
# Falls back to DATABASE_URL if unset.
# DATABASE_MIGRATOR_URL=postgresql://grovyn_migrator:changeme@localhost:5432/grovyn
