# Grovyn backend — environment template. Copy to `.env` (which is gitignored).
# NEVER put real secrets in this file; it is committed as a template only.

# Runtime
NODE_ENV=development
PORT=3001

# CORS: comma-separated allowed origins. In production this MUST be an explicit
# allowlist (never "*" with credentials). Dev defaults to "*" if unset.
# CORS_ORIGIN=https://app.example.com,http://localhost:5173

# Session token signing secret (HMAC). REQUIRED — the app now refuses to
# boot if this is unset (P1-04 closed SEC-01: it previously fell back to a
# public default literal, SECURITY_REVIEWS/000-baseline-owasp.md). Only used
# to sign the legacy in-memory DEMO session tokens (see AUTH_DEMO_MODE below)
# — the real DB-backed session tokens (P1-04) are random + hashed, not
# HMAC-signed, and do not depend on this value. Set a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value

# DEMO ONLY, DEFAULT DISABLED (P1-04/P1-08, closes SEC-06). Set to the exact
# string "true" to mount the legacy shared-password, client-asserted-role
# demo login (`POST /api/v1/auth/demo-login`, `GET /api/v1/auth/demo-stores`)
# for local dev / `npm run verify` only. Any other value (including unset)
# leaves those routes unmounted entirely (404, not just denied) — this must
# NEVER be "true" in a production deployment.
AUTH_DEMO_MODE=false

# DEMO ONLY. Shared demo login password, used only when AUTH_DEMO_MODE=true
# (see above). This must NEVER be a real tenant credential.
AUTH_DEMO_PASSWORD=grovyn@123

# --- Database (P1-01 / P1-02) -----------------------------------------------
# Three DISTINCT connection variables on purpose — do not consolidate them.
# DATABASE_URL and DATABASE_APP_URL are never read by the same code path, and
# the runtime pool (src/db/pool.js) never falls back between them
# (SECURITY_REVIEWS/002 finding IR-03: a runtime connection silently landing
# on the BYPASSRLS migrator role would dissolve every RLS guarantee).

# Runtime app connection — read ONLY by `src/db/pool.js` (P1-02), the pool the
# running server serves every live request through. MUST point at the
# NOBYPASSRLS `grovyn_app` role (see drizzle/0001_force_rls_and_grants.sql) so
# Postgres Row-Level Security (D-001 amendment) is a real backstop behind the
# application-layer DAL (P1-03). There is NO fallback to DATABASE_URL or
# DATABASE_MIGRATOR_URL if this is unset — `src/db/pool.js` throws at import
# time instead (fail loudly at boot, never silently widen privilege).
# REQUIRED as of P1-04: real auth (`/api/v1/auth/login` and everything behind
# `requireSession`) imports this pool at module load, so the whole server now
# fails to boot without it set (the connection itself is lazy — only opened
# on first query — so this only needs to be a syntactically valid URL to
# boot; a genuinely reachable Postgres is needed to actually log in).
DATABASE_APP_URL=postgresql://grovyn_app:changeme@localhost:5432/grovyn

# Migrator connection used ONLY by `npm run db:generate` / `db:migrate`
# (drizzle-kit CLI, see drizzle.config.js). MUST be a BYPASSRLS role (e.g.
# `grovyn_migrator`) so schema DDL and any future seed script can write
# across all tenants. NEVER use this role/URL for request-serving code — it
# is not read by `src/db/pool.js` and must never be.
# DATABASE_MIGRATOR_URL=postgresql://grovyn_migrator:changeme@localhost:5432/grovyn

# Generic fallback consumed ONLY by drizzle.config.js's CLI (`DATABASE_MIGRATOR_URL
# || DATABASE_URL`) when DATABASE_MIGRATOR_URL isn't set — i.e. a convenience
# for local dev where you only bother configuring one URL for the CLI. This is
# NOT a general-purpose "the" database URL: the runtime server (src/db/pool.js)
# never reads it and never will. If you set this, prefer it also being a
# BYPASSRLS migrator-role connection, matching what the CLI actually does with
# it — do not point it at grovyn_app expecting it to serve as a generic default,
# since nothing request-facing consults it.
# DATABASE_URL=postgresql://grovyn_migrator:changeme@localhost:5432/grovyn
